@page "/monsters/new"
@page "/monsters/edit/{Id}"
@inject RulesetContentService ContentService
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Add Monster" : $"Edit {Id}")</PageTitle>

<h1>@(_isNew ? "Add monster" : $"Edit monster: {Id}")</h1>

<ValidationIssuesAlert Result="_saveResult" />

<EditForm Model="_model" OnValidSubmit="Save">
    <div class="mb-3">
        <label class="form-label">Id</label>
        <InputText class="form-control" @bind-Value="_model.Id" disabled="@(!_isNew)" />
        <div class="form-text">Stable identifier, e.g. <code>monster.giant-rat</code>. Cannot be changed once created.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label">Maximum Hit Points</label>
            <InputNumber class="form-control" @bind-Value="_model.MaximumHitPoints" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Armor Class</label>
            <InputNumber class="form-control" @bind-Value="_model.ArmorClass" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Movement Speed (feet)</label>
            <InputNumber class="form-control" @bind-Value="_model.MovementSpeedFeet" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Proficiency Bonus</label>
            <InputNumber class="form-control" @bind-Value="_model.ProficiencyBonus" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Zero Hit Point Policy</label>
            <InputSelect class="form-select" @bind-Value="_model.ZeroHitPointPolicy">
                @foreach (var value in Enum.GetValues<CombatantZeroHitPointPolicy>())
                {
                    <option value="@value">@value</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <InputCheckbox class="form-check-input" id="isProficient" @bind-Value="_model.IsProficientWithWeapons" />
                <label class="form-check-label" for="isProficient">Proficient with weapons</label>
            </div>
        </div>
    </div>

    <hr />
    <h4>Ability Modifiers</h4>

    <div class="row mb-3">
        @foreach (var row in _model.AbilityModifiers)
        {
            <div class="col-md-2">
                <label class="form-label">@row.Ability</label>
                <InputNumber class="form-control" @bind-Value="row.Modifier" />
            </div>
        }
    </div>

    <hr />
    <h4>Weapons</h4>

    @for (int i = 0; i < _model.Weapons.Count; i++)
    {
        var index = i;
        var weaponRow = _model.Weapons[index];

        <div class="card mb-2">
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Weapon</label>
                        <InputSelect class="form-select" @bind-Value="weaponRow.WeaponId">
                            <option value="">(choose a weapon)</option>
                            @foreach (var weapon in _weapons)
                            {
                                <option value="@weapon.Id">@weapon.Name (@weapon.Id)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ammunition Item</label>
                        <InputSelect class="form-select" @bind-Value="weaponRow.AmmunitionItemId">
                            <option value="">(none)</option>
                            @foreach (var item in _equipmentItems)
                            {
                                <option value="@item.Id">@item.Name (@item.Id)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ammunition Quantity</label>
                        <InputNumber class="form-control" @bind-Value="weaponRow.AmmunitionQuantity" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _model.Weapons.RemoveAt(index)">Remove</button>
                    </div>
                </div>
                <div class="form-text">Ammunition item and quantity are an all-or-nothing pair when the weapon consumes ammunition.</div>
            </div>
        </div>
    }

    <button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="AddWeapon">Add weapon</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="monsters">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter]
    public string? Id { get; set; }

    private MonsterFormModel _model = new();
    private bool _isNew;
    private ValidationResult? _saveResult;
    private IReadOnlyList<WeaponDefinition> _weapons = [];
    private IReadOnlyList<EquipmentItemDefinition> _equipmentItems = [];

    protected override void OnInitialized()
    {
        _isNew = string.IsNullOrEmpty(Id);
        _weapons = ContentService.LoadWeapons();
        _equipmentItems = ContentService.LoadEquipmentItems();

        if (!_isNew)
        {
            MonsterDefinition? existing = ContentService.FindMonster(Id!);

            if (existing is not null)
            {
                _model = MonsterFormModel.FromDefinition(existing);
            }
        }
    }

    private void AddWeapon()
    {
        _model.Weapons.Add(new MonsterWeaponFormModel());
    }

    private void Save()
    {
        MonsterDefinition monster = _model.ToDefinition();
        _saveResult = ContentService.SaveMonster(monster);

        if (_saveResult.IsValid)
        {
            Navigation.NavigateTo("monsters");
        }
    }
}
