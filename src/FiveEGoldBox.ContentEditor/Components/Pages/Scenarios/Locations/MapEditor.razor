@page "/scenarios/{ScenarioId}/locations/{LocationId}/map"
@inject ScenarioContentService ScenarioService
@inject NavigationManager Navigation

<PageTitle>Edit map: @LocationId</PageTitle>

@if (_scenario is null)
{
    <p class="text-danger">No scenario found with id <code>@ScenarioId</code>.</p>
}
else if (_model is null)
{
    <p class="text-danger">
        Location <code>@LocationId</code> has no exploration map. Maps are created by
        authoring one into the scenario file; this editor edits an existing map.
    </p>
    <a class="btn btn-secondary" href="@LocationsHref">Back to locations</a>
}
else
{
    <h1>Edit map: <code>@_model.MapId</code></h1>
    <p class="text-muted">Location <code>@LocationId</code> in <code>@ScenarioId</code>.</p>

    <ValidationIssuesAlert Result="_saveResult" />

    <div class="row mb-3">
        <div class="col-md-2">
            <label class="form-label">Width</label>
            <input type="number" class="form-control" min="1" value="@_model.Width"
                   @onchange="@((ChangeEventArgs e) => SetWidth(e.Value?.ToString()))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Height</label>
            <input type="number" class="form-control" min="1" value="@_model.Height"
                   @onchange="@((ChangeEventArgs e) => SetHeight(e.Value?.ToString()))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Starting floor</label>
            <select class="form-select" value="@_model.StartingFloor"
                    @onchange="@((ChangeEventArgs e) => _model.StartingFloor = e.Value?.ToString() ?? "")">
                @foreach (var floor in _model.Floors)
                {
                    <option value="@floor.Floor">@floor.Floor</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Starting position</label>
            <div class="input-group">
                <span class="input-group-text">X</span>
                <input type="number" class="form-control" value="@_model.StartingX"
                       @onchange="@((ChangeEventArgs e) => _model.StartingX = ParseInt(e.Value?.ToString(), _model.StartingX))" />
                <span class="input-group-text">Y</span>
                <input type="number" class="form-control" value="@_model.StartingY"
                       @onchange="@((ChangeEventArgs e) => _model.StartingY = ParseInt(e.Value?.ToString(), _model.StartingY))" />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label">Starting facing</label>
            <select class="form-select" value="@_model.StartingFacing"
                    @onchange="@((ChangeEventArgs e) => SetFacing(e.Value?.ToString()))">
                @foreach (var facing in Enum.GetValues<ExplorationFacingV1>())
                {
                    <option value="@facing">@facing</option>
                }
            </select>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        @foreach (var floor in _model.Floors)
        {
            <li class="nav-item">
                <button type="button" class="nav-link @(floor == _selectedFloor ? "active" : "")"
                        @onclick="@(() => _selectedFloor = floor)">
                    @floor.Floor
                </button>
            </li>
        }
    </ul>

    @if (_selectedFloor is not null)
    {
        <div class="btn-group mb-2" role="group">
            <button type="button"
                    class="btn btn-sm @(_mode == EditMode.Walkable ? "btn-primary" : "btn-outline-primary")"
                    @onclick="@(() => SetMode(EditMode.Walkable))">
                Paint walkable cells
            </button>
            <button type="button"
                    class="btn btn-sm @(_mode == EditMode.Features ? "btn-primary" : "btn-outline-primary")"
                    @onclick="@(() => SetMode(EditMode.Features))">
                Edit cell features
            </button>
        </div>

        <p class="text-muted">
            @if (_mode == EditMode.Walkable)
            {
                <text>Click a cell to toggle whether the party can walk on it.</text>
            }
            else
            {
                <text>Click a cell to edit the stairs, doors, treasure and NPC on it.</text>
            }
            @_selectedFloor.TraversablePositions.Count of @(_model.Width * _model.Height) cells are walkable on this floor.
        </p>

        <div class="map-grid mb-3"
             style="grid-template-columns: repeat(@_model.Width, 3rem);">
            @for (int y = 0; y < _model.Height; y++)
            {
                @for (int x = 0; x < _model.Width; x++)
                {
                    int cellX = x;
                    int cellY = y;
                    <button type="button"
                            class="map-cell @CellClass(cellX, cellY)"
                            title="@CellTitle(cellX, cellY)"
                            @onclick="@(() => CellClicked(cellX, cellY))">
                        <span class="map-cell-coords">@cellX,@cellY</span>
                        <span class="map-cell-markers">@CellMarkers(cellX, cellY)</span>
                    </button>
                }
            }
        </div>

        <div class="map-legend text-muted mb-3">
            <span class="legend-swatch walkable"></span> walkable
            <span class="legend-swatch"></span> blocked
            <span class="ms-3">★ start</span>
            <span class="ms-2">↕ stairs</span>
            <span class="ms-2">$ treasure</span>
            <span class="ms-2">@("@") NPC</span>
            <span class="ms-2">thick edge = door</span>
        </div>

        @if (_mode == EditMode.Features && _selectedCell is not null)
        {
            var (cx, cy) = _selectedCell.Value;

            <div class="card mb-3">
                <div class="card-header">
                    Features on cell (@cx, @cy) &mdash; @_selectedFloor.Floor
                </div>
                <div class="card-body">

                    <h6>Stairs</h6>
                    @if (_selectedFloor.FindStair(cx, cy) is { } stair)
                    {
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3">
                                <label class="form-label">Destination floor</label>
                                <select class="form-select" value="@stair.DestinationFloor"
                                        @onchange="@((ChangeEventArgs e) => stair.DestinationFloor = e.Value?.ToString() ?? "")">
                                    @foreach (var floor in _model.Floors)
                                    {
                                        <option value="@floor.Floor">@floor.Floor</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Destination position</label>
                                <div class="input-group">
                                    <span class="input-group-text">X</span>
                                    <input type="number" class="form-control" value="@stair.DestinationX"
                                           @onchange="@((ChangeEventArgs e) => stair.DestinationX = ParseInt(e.Value?.ToString(), stair.DestinationX))" />
                                    <span class="input-group-text">Y</span>
                                    <input type="number" class="form-control" value="@stair.DestinationY"
                                           @onchange="@((ChangeEventArgs e) => stair.DestinationY = ParseInt(e.Value?.ToString(), stair.DestinationY))" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger" @onclick="@(() => _selectedFloor.Stairs.Remove(stair))">Remove stairs</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => AddStair(cx, cy))">Add stairs</button></p>
                    }

                    <h6>Doors</h6>
                    <p class="form-text mt-0">
                        A door sits on the edge between this cell and its neighbour, so it belongs to a side rather than to the cell itself.
                    </p>
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 5rem;">Side</th>
                                <th>Door Id</th>
                                <th style="width: 7rem;">Secret</th>
                                <th style="width: 7rem;">Locked</th>
                                <th style="width: 6rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var side in Enum.GetValues<ExplorationFacingV1>())
                            {
                                var currentSide = side;
                                var door = _selectedFloor.FindDoor(cx, cy, currentSide);
                                <tr>
                                    <td>@currentSide</td>
                                    @if (door is null)
                                    {
                                        <td colspan="3" class="text-muted">No door</td>
                                        <td><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => AddDoor(cx, cy, currentSide))">Add</button></td>
                                    }
                                    else
                                    {
                                        <td>
                                            <input class="form-control form-control-sm" value="@door.DoorId"
                                                   @onchange="@((ChangeEventArgs e) => door.DoorId = e.Value?.ToString() ?? "")" />
                                        </td>
                                        <td>
                                            <input class="form-check-input" type="checkbox" checked="@door.IsSecret"
                                                   @onchange="@((ChangeEventArgs e) => door.IsSecret = (bool)e.Value!)" />
                                        </td>
                                        <td>
                                            <input class="form-check-input" type="checkbox" checked="@door.IsLocked"
                                                   @onchange="@((ChangeEventArgs e) => door.IsLocked = (bool)e.Value!)" />
                                        </td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => _selectedFloor.Doors.Remove(door))">Remove</button></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    <h6>Treasure</h6>
                    @if (_selectedFloor.FindTreasure(cx, cy) is { } treasure)
                    {
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Treasure Id</label>
                                <input class="form-control" value="@treasure.TreasureId"
                                       @onchange="@((ChangeEventArgs e) => treasure.TreasureId = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Gold pieces</label>
                                <input type="number" class="form-control" value="@treasure.GoldPieces"
                                       @onchange="@((ChangeEventArgs e) => treasure.GoldPieces = ParseOptionalInt(e.Value?.ToString()))" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Item Id</label>
                                <input class="form-control" value="@treasure.ItemId"
                                       @onchange="@((ChangeEventArgs e) => treasure.ItemId = e.Value?.ToString())" />
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Qty</label>
                                <input type="number" class="form-control" value="@treasure.Quantity"
                                       @onchange="@((ChangeEventArgs e) => treasure.Quantity = ParseOptionalInt(e.Value?.ToString()))" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger" @onclick="@(() => _selectedFloor.Treasures.Remove(treasure))">Remove</button>
                            </div>
                            <div class="form-text">Leave Item Id and Qty empty for a gold-only treasure -- empty writes no property at all, rather than an empty one.</div>
                        </div>
                    }
                    else
                    {
                        <p><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => AddTreasure(cx, cy))">Add treasure</button></p>
                    }

                    <h6>NPC</h6>
                    @if (_selectedFloor.FindNpc(cx, cy) is { } npc)
                    {
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-md-4">
                                <label class="form-label">NPC Id</label>
                                <input class="form-control" value="@npc.NpcId"
                                       @onchange="@((ChangeEventArgs e) => npc.NpcId = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Name</label>
                                <input class="form-control" value="@npc.Name"
                                       @onchange="@((ChangeEventArgs e) => npc.Name = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger" @onclick="@(() => _selectedFloor.Npcs.Remove(npc))">Remove</button>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dialogue</label>
                                <textarea class="form-control" rows="2"
                                          @onchange="@((ChangeEventArgs e) => npc.DialogueText = e.Value?.ToString() ?? "")">@npc.DialogueText</textarea>
                            </div>
                        </div>
                        <div class="alert alert-warning py-2 mb-0">
                            An NPC blocks its own square, so this cell must stay <strong>not walkable</strong>. Saving is rejected otherwise.
                        </div>
                    }
                    else
                    {
                        <p class="mb-0"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => AddNpc(cx, cy))">Add NPC</button></p>
                    }
                </div>
            </div>
        }
    }

    <div>
        <button type="button" class="btn btn-primary" @onclick="Save">Save map</button>
        <a class="btn btn-secondary" href="@LocationsHref">Cancel</a>
    </div>
}

@code {
    [Parameter]
    public string ScenarioId { get; set; } = "";

    [Parameter]
    public string LocationId { get; set; } = "";

    private enum EditMode
    {
        Walkable,
        Features
    }

    private ScenarioSummary? _scenario;
    private ExplorationMapFormModel? _model;
    private ExplorationFloorFormModel? _selectedFloor;
    private ValidationResult? _saveResult;
    private EditMode _mode = EditMode.Walkable;
    private (int X, int Y)? _selectedCell;

    private string LocationsHref =>
        $"scenarios/{Uri.EscapeDataString(ScenarioId)}/locations";

    protected override void OnInitialized()
    {
        _scenario = ScenarioService.FindScenario(ScenarioId);

        if (_scenario is null)
        {
            return;
        }

        ExplorationMapDefinitionV1? map = ScenarioService.FindExplorationMap(
            _scenario.FilePath,
            LocationId);

        if (map is null)
        {
            return;
        }

        _model = ExplorationMapFormModel.FromDefinition(map);
        _selectedFloor = _model.Floors.FirstOrDefault();
    }

    /// One click handler, two meanings, by mode: painting a floor plan is a
    /// bulk operation that would be miserable behind a select-then-act step,
    /// while editing features needs a cell selected to hang a panel off.
    private void CellClicked(
        int x,
        int y)
    {
        if (_mode == EditMode.Walkable)
        {
            _selectedFloor?.ToggleTraversable(x, y);
            return;
        }

        _selectedCell = (x, y);
    }

    private void SetMode(EditMode mode)
    {
        _mode = mode;

        if (mode == EditMode.Walkable)
        {
            _selectedCell = null;
        }
    }

    private void AddStair(
        int x,
        int y)
    {
        if (_selectedFloor is null || _model is null)
        {
            return;
        }

        // Defaults to the other floor when there is exactly one, which is the
        // common case (a two-floor building) and saves the author a step.
        string destination = _model.Floors
            .Select(floor => floor.Floor)
            .FirstOrDefault(floor => floor != _selectedFloor.Floor)
            ?? _selectedFloor.Floor;

        _selectedFloor.Stairs.Add(new StairFormModel
        {
            X = x,
            Y = y,
            DestinationFloor = destination,
            DestinationX = x,
            DestinationY = y
        });
    }

    private void AddDoor(
        int x,
        int y,
        ExplorationFacingV1 side)
    {
        if (_selectedFloor is null || _model is null)
        {
            return;
        }

        _selectedFloor.Doors.Add(new DoorFormModel
        {
            DoorId = _model.SuggestFeatureId("door"),
            X = x,
            Y = y,
            Side = side,
            IsSecret = false,
            IsLocked = false
        });
    }

    private void AddTreasure(
        int x,
        int y)
    {
        if (_selectedFloor is null || _model is null)
        {
            return;
        }

        _selectedFloor.Treasures.Add(new TreasureFormModel
        {
            TreasureId = _model.SuggestFeatureId("treasure"),
            X = x,
            Y = y,
            GoldPieces = 0
        });
    }

    private void AddNpc(
        int x,
        int y)
    {
        if (_selectedFloor is null || _model is null)
        {
            return;
        }

        _selectedFloor.Npcs.Add(new NpcFormModel
        {
            NpcId = _model.SuggestFeatureId("npc"),
            X = x,
            Y = y,
            Name = "New NPC",
            DialogueText = ""
        });
    }

    private string CellClass(
        int x,
        int y)
    {
        if (_selectedFloor is null)
        {
            return "";
        }

        List<string> classes = [];

        if (_selectedFloor.IsTraversable(x, y))
        {
            classes.Add("walkable");
        }

        if (_model is not null
            && _model.StartingFloor == _selectedFloor.Floor
            && _model.StartingX == x
            && _model.StartingY == y)
        {
            classes.Add("start");
        }

        foreach (var door in _selectedFloor.Doors.Where(d => d.X == x && d.Y == y))
        {
            classes.Add($"door-{door.Side.ToString().ToLowerInvariant()}");

            if (door.IsSecret)
            {
                classes.Add("door-secret");
            }
        }

        if (_selectedCell is { } selected && selected.X == x && selected.Y == y)
        {
            classes.Add("selected");
        }

        return string.Join(" ", classes);
    }

    private string CellMarkers(
        int x,
        int y)
    {
        if (_selectedFloor is null)
        {
            return "";
        }

        List<string> markers = [];

        if (_model is not null
            && _model.StartingFloor == _selectedFloor.Floor
            && _model.StartingX == x
            && _model.StartingY == y)
        {
            markers.Add("★");
        }

        if (_selectedFloor.FindStair(x, y) is not null)
        {
            markers.Add("↕");
        }

        if (_selectedFloor.FindTreasure(x, y) is not null)
        {
            markers.Add("$");
        }

        if (_selectedFloor.FindNpc(x, y) is not null)
        {
            markers.Add("@");
        }

        return string.Concat(markers);
    }

    private string CellTitle(
        int x,
        int y)
    {
        if (_selectedFloor is null)
        {
            return "";
        }

        List<string> parts =
        [
            $"({x}, {y}) {(_selectedFloor.IsTraversable(x, y) ? "walkable" : "blocked")}"
        ];

        foreach (var stair in _selectedFloor.Stairs.Where(s => s.X == x && s.Y == y))
        {
            parts.Add($"stairs to {stair.DestinationFloor} ({stair.DestinationX}, {stair.DestinationY})");
        }

        foreach (var door in _selectedFloor.Doors.Where(d => d.X == x && d.Y == y))
        {
            string kind = door.IsSecret ? "secret door" : "door";
            string locked = door.IsLocked ? ", locked" : "";
            parts.Add($"{kind} on {door.Side} side{locked} ({door.DoorId})");
        }

        foreach (var treasure in _selectedFloor.Treasures.Where(t => t.X == x && t.Y == y))
        {
            parts.Add($"treasure: {treasure.TreasureId}");
        }

        foreach (var npc in _selectedFloor.Npcs.Where(n => n.X == x && n.Y == y))
        {
            parts.Add($"NPC: {npc.Name}");
        }

        return string.Join(" · ", parts);
    }

    private void SetWidth(string? raw)
    {
        if (_model is not null)
        {
            _model.Width = Math.Max(1, ParseInt(raw, _model.Width));
        }
    }

    private void SetHeight(string? raw)
    {
        if (_model is not null)
        {
            _model.Height = Math.Max(1, ParseInt(raw, _model.Height));
        }
    }

    private void SetFacing(string? raw)
    {
        if (_model is not null && Enum.TryParse(raw, out ExplorationFacingV1 facing))
        {
            _model.StartingFacing = facing;
        }
    }

    private static int ParseInt(
        string? raw,
        int fallback)
    {
        return int.TryParse(raw, out int value) ? value : fallback;
    }

    /// Empty stays null rather than becoming 0, so clearing a treasure's
    /// Quantity omits the property instead of writing a meaningless zero.
    private static int? ParseOptionalInt(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        return int.TryParse(raw, out int value) ? value : null;
    }

    private void Save()
    {
        if (_scenario is null || _model is null)
        {
            return;
        }

        _saveResult = ScenarioService.SaveExplorationMap(
            _scenario.FilePath,
            LocationId,
            _model.ToDefinition());

        if (_saveResult.IsValid)
        {
            Navigation.NavigateTo(LocationsHref);
        }
    }
}
