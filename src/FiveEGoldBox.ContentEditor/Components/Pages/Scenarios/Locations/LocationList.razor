@page "/scenarios/{ScenarioId}/locations"
@inject ScenarioContentService ScenarioService

<PageTitle>Locations -- @ScenarioId</PageTitle>

@if (_scenario is null)
{
    <p class="text-danger">No scenario found with id <code>@ScenarioId</code>.</p>
}
else
{
    <h1>Locations -- @_scenario.DisplayName</h1>
    <a class="btn btn-secondary mb-3" href="@($"scenarios/{Uri.EscapeDataString(ScenarioId)}")">&larr; Back to scenario</a>
    <a class="btn btn-primary mb-3" href="@($"scenarios/{Uri.EscapeDataString(ScenarioId)}/locations/new")">Add new location</a>

    <ValidationIssuesAlert Result="_lastDeleteResult" />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Has exploration map</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in _locations)
            {
                <tr>
                    <td><code>@location.LocationId</code></td>
                    <td>@location.DisplayName</td>
                    <td>@(location.ExplorationMap is null ? "No" : "Yes")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary me-1" href="@($"scenarios/{Uri.EscapeDataString(ScenarioId)}/locations/edit/{Uri.EscapeDataString(location.LocationId)}")">Edit</a>
                        <DeleteButton OnConfirmed="() => Delete(location.LocationId)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public string ScenarioId { get; set; } = "";

    private ScenarioSummary? _scenario;
    private IReadOnlyList<ScenarioLocationDefinitionV1> _locations = [];
    private ValidationResult? _lastDeleteResult;

    protected override void OnInitialized()
    {
        Refresh();
    }

    private void Refresh()
    {
        _scenario = ScenarioService.FindScenario(ScenarioId);
        _locations = _scenario is null ? [] : ScenarioService.LoadLocations(_scenario.FilePath);
    }

    private void Delete(
        string locationId)
    {
        if (_scenario is null)
        {
            return;
        }

        _lastDeleteResult = ScenarioService.DeleteLocation(_scenario.FilePath, locationId);
        Refresh();
    }
}
