@page "/equipment-items/new"
@page "/equipment-items/edit/{Id}"
@inject RulesetContentService ContentService
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Add Equipment Item" : $"Edit {Id}")</PageTitle>

<h1>@(_isNew ? "Add equipment item" : $"Edit equipment item: {Id}")</h1>

<ValidationIssuesAlert Result="_saveResult" />

<EditForm Model="_model" OnValidSubmit="Save">
    <div class="mb-3">
        <label class="form-label">Id</label>
        <InputText class="form-control" @bind-Value="_model.Id" disabled="@(!_isNew)" />
        <div class="form-text">Stable identifier, e.g. <code>item.arrow</code>. Cannot be changed once created.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Weight (pounds)</label>
            <InputNumber class="form-control" @bind-Value="_model.WeightPounds" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Cost (copper pieces)</label>
            <InputNumber class="form-control" @bind-Value="_model.CostInCopperPieces" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Tags</label>
        <InputText class="form-control" @bind-Value="_model.TagsText" />
        <div class="form-text">Comma-separated. Free text -- there is no fixed set of item tags.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" href="equipment-items">Cancel</a>
</EditForm>

@code {
    [Parameter]
    public string? Id { get; set; }

    private EquipmentItemFormModel _model = new();
    private bool _isNew;
    private ValidationResult? _saveResult;

    protected override void OnInitialized()
    {
        _isNew = string.IsNullOrEmpty(Id);

        if (!_isNew)
        {
            EquipmentItemDefinition? existing = ContentService.FindEquipmentItem(Id!);

            if (existing is not null)
            {
                _model = EquipmentItemFormModel.FromDefinition(existing);
            }
        }
    }

    private void Save()
    {
        EquipmentItemDefinition item = _model.ToDefinition();
        _saveResult = ContentService.SaveEquipmentItem(item);

        if (_saveResult.IsValid)
        {
            Navigation.NavigateTo("equipment-items");
        }
    }
}
