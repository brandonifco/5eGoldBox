[gd_resource type="Theme" load_steps=22 format=3]

; EGA Revival palette, hairline frame.
;
; The hues reference the 16-colour EGA palette the Gold Box games shipped
; with - amber, cyan, bone on deep navy - desaturated and spaced for a
; modern display rather than reproduced literally.
;
;   ground     #0E1220   deepest field, presentation surface
;   surface    #171E31   panels
;   surface-2  #202942   raised panels, command buttons
;   rule       #35406A   hairline borders
;   ink        #DCE4F5   body text
;   muted      #7E8BB0   secondary text
;   accent     #F0B429   amber - the only bright thing on screen
;   accent-2   #48C0D8   cyan - beneficial effects
;   good       #5BC46A   bad #E0574C
;
; Frame: 1px borders, square corners. Focus rings stay 2px on purpose -
; that is a keyboard affordance, not part of the frame treatment.

