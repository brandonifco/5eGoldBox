          Link="Fixtures\data-campaigns-frontier-campaign.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveEGoldBox.Application\FiveEGoldBox.Application.csproj" />
    <ProjectReference Include="..\..\src\FiveEGoldBox.Core\FiveEGoldBox.Core.csproj" />
  </ItemGroup>

